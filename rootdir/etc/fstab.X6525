# SPDX-License-Identifier: Apache-2.0
#
# Android fstab for Infinix Smart 8 (X6525 / ums9230).
#
# This file is installed as /first_stage_ramdisk/fstab.X6525 in vendor_boot and
# is also used as TARGET_RECOVERY_FSTAB. The stock /vendor/etc/fstab.X6525 is
# still shipped from the dump and is what second-stage init uses; keep the two
# in sync.
#
# AVB note: the `avb=` / `avb_keys=` flags from the stock fstab are deliberately
# dropped. We build our own vbmeta with --flags 3 (verity + verification off),
# so there is nothing useful to verify against. If you later want verified boot,
# restore the stock flags and sign with the real keys, and recreate the stock
# five-image chain (vbmeta_system / vbmeta_vendor / vbmeta_odm / vbmeta_product /
# vbmeta_system_ext) instead of this tree's two-group split; see
# docs/DEVICE_TREE.md section 6.

# ---------------------------------------------------------------------------
# Logical (dynamic) partitions
# ---------------------------------------------------------------------------
system       /system       erofs  ro                     wait,logical,first_stage_mount,slotselect
system       /system       ext4   ro,barrier=1           wait,logical,first_stage_mount,slotselect
system_ext   /system_ext   erofs  ro                     wait,logical,first_stage_mount,slotselect
vendor       /vendor       erofs  ro                     wait,logical,first_stage_mount,slotselect
odm          /odm          erofs  ro                     wait,logical,first_stage_mount,slotselect
product      /product      erofs  ro                     wait,logical,first_stage_mount,slotselect
vendor_dlkm  /vendor_dlkm  erofs  ro                     wait,logical,first_stage_mount,slotselect

# ---------------------------------------------------------------------------
# Metadata (FBE keys + virtual A/B snapshots)
# ---------------------------------------------------------------------------
/dev/block/by-name/metadata  /metadata  f2fs  nodev,noatime,nosuid                wait,formattable,first_stage_mount,check
/dev/block/by-name/metadata  /metadata  ext4  nodev,noatime,nosuid,errors=panic  wait,formattable,first_stage_mount,check

# ---------------------------------------------------------------------------
# Physical partitions
# ---------------------------------------------------------------------------
/dev/block/by-name/userdata  /data  f2fs  noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,inline_xattr,inline_data,inlinecrypt,fsync_mode=nobarrier,compress_cache,compress_algorithm=lz4,compress_log_size=2,compress_extension=apk,compress_extension=so,compress_mode=fs  latemount,wait,quota,check,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,reservedsize=128M,checkpoint=fs,formattable,fscompress,sysfs_path=/sys/devices/platform/soc/soc:ap-apb/20200000.ufs

/dev/block/by-name/cache     /cache     f2fs  noatime,nosuid,nodev,discard                                   wait,check,formattable
/dev/block/by-name/cache     /cache     ext4  noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc       wait,check,formattable
/dev/block/by-name/misc      /misc      emmc  defaults                                                       defaults
/dev/block/by-name/tranfs    /tranfs    ext4  rw,noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc  wait,check,formattable,nofail,first_stage_mount
/dev/block/by-name/prodnv    /mnt/vendor        ext4  noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc    wait,check,nofail
/dev/block/by-name/blackbox  /blackbox  ext4  noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc    wait,check,nofail
/dev/block/by-name/blackbox  /blackbox  f2fs  noatime,nosuid,nodev,discard                                   wait,check,nofail

# Uncomment if your dump has a /persist mount in the stock fstab.
#/dev/block/by-name/persist   /persist   ext4  noatime,nosuid,nodev,nomblk_io_submit,noauto_da_alloc    wait,check

# ---------------------------------------------------------------------------
# USB / external storage (vold)
# ---------------------------------------------------------------------------
/devices/platform/soc/soc:*/*.usb/musb-hdrc.*.auto/usb*                   auto  vfat  defaults  voldmanaged=usbdisk:auto,encryptable=userdata
/devices/platform/soc/soc:ap-*/*.sdio/mmc_host/mmc1/mmc1:*/block/mmcblk1  auto  vfat  defaults  voldmanaged=sdcard0:auto,noemulatedsd,encryptable=footer
