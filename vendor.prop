# SPDX-License-Identifier: Apache-2.0
#
# Vendor properties for Infinix Smart 8 (X6525 / ums9230).
#
# IMPORTANT: these were seeded from a known ums9230 Transsion tree. Some
# reference props came from a T616 sibling and are *wrong* for the T606 used
# here (that is why ro.soc.model is overridden below). Always diff this file
# against /vendor/build.prop from your own dump:
#
#     python3 tools/collect-props.py <dump> > props.dump.txt
#
# and keep the values your device actually reports.

# ---- SoC -------------------------------------------------------------------
# Verified from stock device getprop (ro.soc.* reports Spreadtrum/T616 even
# though the efuse/marketing chip is T606).
ro.soc.manufacturer=Spreadtrum
ro.soc.model=T616

# ---- Audio -----------------------------------------------------------------
ro.hardware.audio.primary=whale
ro.vendor.audio.whale_hal=true
persist.audio.bigvolume.enabled=true
persist.audio.bigvolume.switch=false
persist.vendor.audio.hifi_enabled=false
ro.audio.offload_wakelock=false

# ---- Bluetooth -------------------------------------------------------------
ro.bluetooth.a2dp_offload.supported=false
persist.bluetooth.a2dp_offload.cap=sbc
persist.bluetooth.a2dp_offload.switch=true
bluetooth.profile.a2dp.source.enabled=true
bluetooth.profile.avrcp.target.enabled=true
bluetooth.profile.bas.client.enabled=true
bluetooth.profile.gatt.enabled=true
bluetooth.profile.hfp.ag.enabled=true
bluetooth.profile.hid.device.enabled=true
bluetooth.profile.hid.host.enabled=true
bluetooth.profile.map.server.enabled=true
bluetooth.profile.opp.enabled=true
bluetooth.profile.pan.nap.enabled=true
bluetooth.profile.pan.panu.enabled=true
bluetooth.profile.pbap.server.enabled=true

# ---- Display / graphics ----------------------------------------------------
ro.hardware.hwcomposer=unisoc
ro.hardware.enhance=unisoc
ro.hardware.gsp=unisoc
ro.hardware.dpu=unisoc
ro.opengles.version=196610
debug.sf.auto_latch_unsignaled=false
debug.sf.enable_skip_rotation=1
ro.surface_flinger.has_HDR_display=false
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.max_frame_buffer_acquired_buffers=3
ro.surface_flinger.max_virtual_display_dimension=4096
ro.surface_flinger.primary_display_orientation=ORIENTATION_0
ro.surface_flinger.start_graphics_allocator_service=false
ro.surface_flinger.use_context_priority=true
ro.surface_flinger.vsync_event_phase_offset_ns=1000000
ro.surface_flinger.vsync_sf_event_phase_offset_ns=1000000

# ---- Sensors ---------------------------------------------------------------
ro.hardware.sensors=unisoc

# ---- Wi-Fi / WCN -----------------------------------------------------------
wifi.interface=wlan0
wifi.direct.interface=p2p-dev-wlan0
ro.wifi.channels=
ro.vendor.wcn.hardware.product=marlin3_internal
ro.vendor.wcn.gpschip=marlin3lite-Integ
ro.vendor.wcn.hardware.etcpath=/odm/firmware
ro.vendor.modem.wcn.count=1
ro.vendor.modem.wcn.enable=1
ro.vendor.modem.wcn.id=1

# ---- Radio / modem ---------------------------------------------------------
ro.telephony.default_network=9
ro.vendor.radio.modemtype=l
ro.vendor.modem.support=1
ro.vendor.modem.dev=/proc/cptl/
ro.vendor.modem.tty=/dev/stty_lte
ro.vendor.modem.loop=/dev/spipe_lte0
ro.vendor.modem.nv=/dev/spipe_lte1
ro.vendor.modem.diag=/dev/sdiag_lte
ro.vendor.modem.log=/dev/slog_lte
ro.vendor.modem.assert=/dev/spipe_lte2
ro.vendor.modem.fixnv_size=0x100000
ro.vendor.modem.runnv_size=0x120000
ro.vendor.modem.nvp=l_
ro.rebootescrow.device=/dev/block/pmem0

# ---- Storage ---------------------------------------------------------------
ro.storage.flash_type=2
external_storage.casefold.enabled=1
external_storage.projid.enabled=1
external_storage.sdcardfs.enabled=0

# ---- Fingerprint -----------------------------------------------------------
persist.fingerprint.location=RIGHT

# ---- Media -----------------------------------------------------------------
media.stagefright.thumbnail.prefer_hw_codecs=true
vendor.media.omx=0

# ---- Power / LMK -----------------------------------------------------------
ro.lmk.critical_upgrade=true
ro.lmk.kill_heaviest_task=false
ro.lmk.upgrade_pressure=40
ro.lmk.downgrade_pressure=60

# ---- Virtual A/B -----------------------------------------------------------
ro.virtual_ab.compression.enabled=true
ro.virtual_ab.compression.xor.enabled=false
ro.virtual_ab.io_uring.enabled=false
ro.virtual_ab.userspace.snapshots.enabled=true

# ---- Misc ------------------------------------------------------------------
ro.control_privapp_permissions=enforce
ro.frp.pst=/dev/block/by-name/persist
ro.oem_unlock_supported=1
persist.sys.zram_enabled=1
persist.sys.usb.config=adb
